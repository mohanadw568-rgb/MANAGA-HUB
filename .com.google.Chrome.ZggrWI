<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#0b0b0f">
<title>MANGA HUB — عالم المانجا</title>
<style>
:root{--bg:#0b0b0f;--panel:#14141c;--panel2:#1b1b25;--red:#ef233c;--text:#f5f5f7;--muted:#a6a6b3;--line:#2b2b36}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,"Segoe UI",Tahoma,Arial,sans-serif;line-height:1.7}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}.wrap{width:min(1120px,92%);margin:auto}.top{background:#111116;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:10}.nav{display:flex;align-items:center;gap:18px;padding:13px 0}.logo{font-weight:950;font-size:1.35rem;letter-spacing:1px;white-space:nowrap}.logo b{color:var(--red)}.links{display:flex;gap:17px;margin-inline-start:auto;color:#ddd;font-size:.94rem}.links a:hover,.links a:focus{color:#ff6677}.lang{border:1px solid #41414c;background:#1b1b24;color:white;border-radius:9px;padding:7px 10px;cursor:pointer}.hero{padding:36px 0 26px}.hero-card{border:1px solid #3a2028;border-radius:22px;overflow:hidden;background:radial-gradient(circle at 15% 15%,#45131f 0,transparent 37%),linear-gradient(115deg,#1b1118,#101016 60%,#241017);padding:clamp(24px,5vw,54px);position:relative}.eyebrow{color:#ff7c8b;font-weight:800;font-size:.85rem}.hero h1{font-size:clamp(2rem,6vw,3.6rem);line-height:1.2;margin:10px 0}.hero p{max-width:600px;color:#d0cbd1}.btn{display:inline-block;background:var(--red);color:#fff;border:0;border-radius:10px;padding:11px 17px;font-weight:800;cursor:pointer}.btn.secondary{background:#24242e;border:1px solid #41414c}.hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}.section{padding:22px 0 32px}.section-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px}.section h2{font-size:1.35rem;margin:0}.section h2:before{content:"";display:inline-block;width:5px;height:23px;background:var(--red);border-radius:4px;margin-inline-end:9px;vertical-align:middle}.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}.search{flex:1;min-width:170px;background:#15151d;border:1px solid var(--line);border-radius:10px;color:white;padding:10px 12px}.chip{background:#171720;border:1px solid var(--line);color:#ddd;padding:7px 12px;border-radius:999px;cursor:pointer}.chip.active{background:#3b151d;border-color:var(--red);color:#fff}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px}.manga{background:var(--panel);border:1px solid var(--line);border-radius:14px;overflow:hidden;transition:transform .18s,border-color .18s}.manga:hover{transform:translateY(-3px);border-color:#7d2636}.cover{height:210px;display:flex;align-items:end;padding:13px;background:linear-gradient(180deg,transparent 25%,rgba(0,0,0,.85)),var(--cover,#30131a);position:relative}.cover:before{content:attr(data-mark);position:absolute;inset:12px 0 auto;text-align:center;font-size:4.1rem;font-weight:950;color:#ffffff1e;letter-spacing:-5px}.cover span{font-size:1.05rem;font-weight:900;position:relative}.manga-body{padding:12px}.meta{font-size:.8rem;color:var(--muted);display:flex;justify-content:space-between;gap:8px}.manga-body p{font-size:.88rem;color:#c4c4ce;margin:7px 0 10px}.small-btn{background:#272731;border:1px solid #393945;border-radius:8px;color:white;padding:7px 10px;cursor:pointer;width:100%}.empty{display:none;color:var(--muted);padding:20px}.feature{display:grid;grid-template-columns:1.2fr .8fr;gap:16px}.box{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:20px}.box p{color:var(--muted)}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.step{background:#1b1b25;padding:13px;border-radius:12px;border:1px solid var(--line)}.step b{color:#ff6578}.submit-form{display:grid;gap:11px}.submit-form input,.submit-form select,.submit-form textarea{width:100%;background:#0f0f15;color:white;border:1px solid #373743;border-radius:9px;padding:10px}.notice{font-size:.82rem;color:#b9b9c5}.reader{display:none;background:#050507;border:1px solid #333;border-radius:14px;padding:20px;margin-top:14px}.reader.show{display:block}.reader img{display:block;max-width:100%;height:auto;margin:12px auto}.footer{border-top:1px solid var(--line);padding:24px 0;color:var(--muted);font-size:.88rem;margin-top:25px}.footer-row{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}.toast{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);background:#22222c;border:1px solid #4a4a56;color:#fff;padding:10px 14px;border-radius:10px;display:none;z-index:20;max-width:90%}.toast.show{display:block}
@media(max-width:800px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.cover{height:185px}.feature{grid-template-columns:1fr}.links{gap:10px;font-size:.85rem}.nav{gap:10px}}
@media(max-width:430px){.links a:nth-child(2){display:none}.logo{font-size:1.08rem}.cover{height:155px}.cover:before{font-size:3.1rem}.nav{flex-wrap:wrap}.lang{margin-inline-start:auto}.section-head{align-items:flex-start}}
</style>
</head>
<body>
<header class="top"><div class="wrap nav">
<a class="logo" href="#home" aria-label="Manga Hub"><b>MANGA</b> HUB</a>
<nav class="links"><a href="#library" data-i="library">المكتبة</a><a href="#submit" data-i="submit">انشر مانجتك</a><a href="#about" data-i="about">عن الموقع</a></nav>
<button class="lang" id="langBtn" type="button">English</button>
</div></header>
<main id="home" class="wrap">
<section class="hero"><div class="hero-card">
<div class="eyebrow" data-i="eyebrow">عالمك الجديد يبدأ من هنا</div>
<h1 data-i="heroTitle">اقرأ. اكتشف. انشر قصتك.</h1>
<p data-i="heroText">مكان لعشاق المانجا وصنّاع القصص المستقلة. اكتشف عوالم جديدة، وتعرّف على أعمال مبدعين من كل مكان.</p>
<div class="hero-actions"><a class="btn" href="#library" data-i="browse">تصفح المكتبة</a><a class="btn secondary" href="#submit" data-i="publish">انشر عملك</a></div>
</div></section>
<section id="library" class="section">
<div class="section-head"><h2 data-i="libraryTitle">مكتبة المانجا</h2><span class="notice" data-i="demo">أعمال تجريبية — استبدلها بأعمالك</span></div>
<div class="filters"><input id="search" class="search" type="search" placeholder="ابحث عن مانجا أو تصنيف..." aria-label="Search manga"><button class="chip active" data-filter="all" data-i="all">الكل</button><button class="chip" data-filter="Fantasy" data-i="fantasy">فانتازيا</button><button class="chip" data-filter="Mystery" data-i="mystery">غموض</button><button class="chip" data-filter="Action" data-i="action">أكشن</button></div>
<div id="grid" class="grid">
<article class="manga" data-title="the last symbol الرمز الأخير" data-category="Fantasy Mystery"><div class="cover" data-mark="LS" style="--cover:radial-gradient(circle at 70% 20%,#5b2030,#17111b 60%,#09090d)"><span>THE LAST SYMBOL</span></div><div class="manga-body"><div class="meta"><span>فانتازيا • غموض</span><span>مانجا</span></div><p>عالم تحكمه العين، ورمز قد يغيّر مصير الجميع.</p><button class="small-btn" data-open="last" data-i="read">عرض التفاصيل</button></div></article>
<article class="manga" data-title="shadow gate بوابة الظلال" data-category="Fantasy"><div class="cover" data-mark="影" style="--cover:radial-gradient(circle at 30% 20%,#38405f,#10121c 60%,#08090e)"><span>SHADOW GATE</span></div><div class="manga-body"><div class="meta"><span>فانتازيا</span><span>تجريبي</span></div><p>رحلة إلى بوابة غامضة تخفي أسرار عالم منسي.</p><button class="small-btn" data-open="shadow" data-i="read">عرض التفاصيل</button></div></article>
<article class="manga" data-title="red horizon الأفق الأحمر" data-category="Action"><div class="cover" data-mark="赤" style="--cover:radial-gradient(circle at 60% 15%,#a53637,#291019 60%,#08090e)"><span>RED HORIZON</span></div><div class="manga-body"><div class="meta"><span>أكشن</span><span>تجريبي</span></div><p>حين يتغيّر العالم، يصبح القرار أصعب من القتال.</p><button class="small-btn" data-open="red" data-i="read">عرض التفاصيل</button></div></article>
<article class="manga" data-title="silent moon القمر الصامت" data-category="Mystery"><div class="cover" data-mark="月" style="--cover:radial-gradient(circle at 50% 20%,#58627d,#191a2c 60%,#08090e)"><span>SILENT MOON</span></div><div class="manga-body"><div class="meta"><span>غموض</span><span>تجريبي</span></div><p>رسائل تظهر كل ليلة، ولا أحد يعرف من يرسلها.</p><button class="small-btn" data-open="moon" data-i="read">عرض التفاصيل</button></div></article>
</div><p id="empty" class="empty" data-i="empty">لا توجد نتائج مطابقة.</p>
<div id="reader" class="reader" aria-live="polite"><button id="closeReader" class="chip" data-i="close">إغلاق ✕</button><h3 id="readerTitle">THE LAST SYMBOL</h3><p id="readerText">أضف هنا وصف العمل ورابط فصوله.</p><p class="notice" data-i="readerNotice">هذه واجهة تجريبية فقط؛ لم يتم رفع صفحات الفصول بعد.</p></div>
</section>
<section id="submit" class="section"><div class="section-head"><h2 data-i="submitTitle">انشر مانجتك</h2></div>
<div class="feature"><div class="box"><h3 data-i="submitHeading">هل أنت صانع قصص؟</h3><p data-i="submitText">قدّم معلومات عملك للمراجعة. في النسخة التجريبية، النموذج لا يرسل البيانات إلى إدارة الموقع؛ اربطه لاحقًا بنموذج WordPress أو بريد مخصص.</p>
<form id="submitForm" class="submit-form"><label><span data-i="nameLabel">اسم المؤلف</span><input required name="creator" placeholder="اسمك / Your name"></label><label><span data-i="titleLabel">اسم المانجا</span><input required name="title" placeholder="اسم العمل / Manga title"></label><label><span data-i="genreLabel">التصنيف</span><select name="genre"><option>فانتازيا / Fantasy</option><option>غموض / Mystery</option><option>أكشن / Action</option><option>رعب / Horror</option><option>أخرى / Other</option></select></label><label><span data-i="linkLabel">رابط العمل (اختياري)</span><input name="url" type="url" placeholder="https://..."></label><button class="btn" type="submit" data-i="submitBtn">تجهيز طلب الإرسال</button><p class="notice" data-i="formNotice">لن تُرسل البيانات تلقائيًا في هذا النموذج التجريبي.</p></form></div>
<div id="about" class="box"><h3 data-i="aboutTitle">كيف تنشر عملك؟</h3><div class="steps"><div class="step"><b>01</b><br><span data-i="step1">جهّز معلومات المانجا</span></div><div class="step"><b>02</b><br><span data-i="step2">أرسلها للمراجعة</span></div><div class="step"><b>03</b><br><span data-i="step3">تُضاف بعد الموافقة</span></div></div><hr style="border-color:var(--line);margin:20px 0"><h3 data-i="mission">عن MANGA HUB</h3><p data-i="missionText">مساحة تجمع القرّاء والمبدعين، وتمنح القصص المستقلة فرصة للوصول إلى جمهور جديد.</p><p class="notice" data-i="platformNote">نموذج تصميم أولي مستقل. يحتاج ربطه بووردبريس لإدارة المحتوى فعليًا.</p></div></div>
</section>
</main>
<footer class="footer"><div class="wrap footer-row"><span>© <span id="year"></span> MANGA HUB</span><span data-i="footer">صُنع لعشاق المانجا والقصص الأصلية.</span></div></footer>
<div class="toast" id="toast" role="status"></div>
<script>
const translations={
ar:{library:"المكتبة",submit:"انشر مانجتك",about:"عن الموقع",eyebrow:"عالمك الجديد يبدأ من هنا",heroTitle:"اقرأ. اكتشف. انشر قصتك.",heroText:"مكان لعشاق المانجا وصنّاع القصص المستقلة. اكتشف عوالم جديدة، وتعرّف على أعمال مبدعين من كل مكان.",browse:"تصفح المكتبة",publish:"انشر عملك",libraryTitle:"مكتبة المانجا",demo:"أعمال تجريبية — استبدلها بأعمالك",all:"الكل",fantasy:"فانتازيا",mystery:"غموض",action:"أكشن",read:"عرض التفاصيل",empty:"لا توجد نتائج مطابقة.",close:"إغلاق ✕",readerNotice:"هذه واجهة تجريبية فقط؛ لم يتم رفع صفحات الفصول بعد.",submitTitle:"انشر مانجتك",submitHeading:"هل أنت صانع قصص؟",submitText:"قدّم معلومات عملك للمراجعة. في النسخة التجريبية، النموذج لا يرسل البيانات إلى إدارة الموقع؛ اربطه لاحقًا بنموذج WordPress أو بريد مخصص.",nameLabel:"اسم المؤلف",titleLabel:"اسم المانجا",genreLabel:"التصنيف",linkLabel:"رابط العمل (اختياري)",submitBtn:"تجهيز طلب الإرسال",formNotice:"لن تُرسل البيانات تلقائيًا في هذا النموذج التجريبي.",aboutTitle:"كيف تنشر عملك؟",step1:"جهّز معلومات المانجا",step2:"أرسلها للمراجعة",step3:"تُضاف بعد الموافقة",mission:"عن MANGA HUB",missionText:"مساحة تجمع القرّاء والمبدعين، وتمنح القصص المستقلة فرصة للوصول إلى جمهور جديد.",platformNote:"نموذج تصميم أولي مستقل. يحتاج ربطه بووردبريس لإدارة المحتوى فعليًا.",footer:"صُنع لعشاق المانجا والقصص الأصلية.",formToast:"تم تجهيز ملخص الطلب على الشاشة — لم يُرسل لأي جهة."},
en:{library:"Library",submit:"Submit Manga",about:"About",eyebrow:"Your next world starts here",heroTitle:"Read. Discover. Share your story.",heroText:"A home for manga fans and independent creators. Discover new worlds and meet original stories from creators everywhere.",browse:"Browse Library",publish:"Submit Your Work",libraryTitle:"Manga Library",demo:"Demo entries — replace with your works",all:"All",fantasy:"Fantasy",mystery:"Mystery",action:"Action",read:"View details",empty:"No matching results.",close:"Close ✕",readerNotice:"This is a demo interface; chapter pages have not been uploaded.",submitTitle:"Submit Your Manga",submitHeading:"Are you a storyteller?",submitText:"Send your work details for review. This demo form does not send data to site management; connect it to a WordPress form or email later.",nameLabel:"Creator name",titleLabel:"Manga title",genreLabel:"Genre",linkLabel:"Work link (optional)",submitBtn:"Prepare submission",formNotice:"This demo form does not automatically send your information.",aboutTitle:"How to publish",step1:"Prepare manga details",step2:"Submit for review",step3:"Publish after approval",mission:"About MANGA HUB",missionText:"A space for readers and creators, helping independent stories reach a new audience.",platformNote:"Standalone prototype. Connect it to WordPress to manage real content.",footer:"Made for manga fans and original stories.",formToast:"Submission summary prepared on screen — nothing was sent."}
};
let lang="ar",currentFilter="all";
function setLang(next){lang=next;document.documentElement.lang=next;document.documentElement.dir=next==="ar"?"rtl":"ltr";document.getElementById("langBtn").textContent=next==="ar"?"English":"العربية";document.querySelectorAll("[data-i]").forEach(el=>{const key=el.dataset.i;if(translations[next][key])el.textContent=translations[next][key]});document.getElementById("search").placeholder=next==="ar"?"ابحث عن مانجا أو تصنيف...":"Search manga or genre...";filterCards()}
document.getElementById("langBtn").addEventListener("click",()=>setLang(lang==="ar"?"en":"ar"));
document.querySelectorAll("[data-filter]").forEach(btn=>btn.addEventListener("click",()=>{document.querySelectorAll("[data-filter]").forEach(b=>b.classList.remove("active"));btn.classList.add("active");currentFilter=btn.dataset.filter;filterCards()}));
function filterCards(){const q=document.getElementById("search").value.trim().toLowerCase();let visible=0;document.querySelectorAll(".manga").forEach(card=>{const okText=(card.dataset.title+" "+card.innerText).toLowerCase().includes(q);const okCat=currentFilter==="all"||card.dataset.category.includes(currentFilter);card.style.display=okText&&okCat?"":"none";if(okText&&okCat)visible++});document.getElementById("empty").style.display=visible?"none":"block"}
document.getElementById("search").addEventListener("input",filterCards);
const details={last:["THE LAST SYMBOL","عالم تحكمه العين، وظهور الرمز الأخير يهدد النظام. أضف روابط الفصول هنا."],shadow:["SHADOW GATE","قصة تجريبية: أضف ملخصك وروابط الفصول هنا."],red:["RED HORIZON","قصة تجريبية: أضف ملخصك وروابط الفصول هنا."],moon:["SILENT MOON","قصة تجريبية: أضف ملخصك وروابط الفصول هنا."]};
document.querySelectorAll("[data-open]").forEach(btn=>btn.addEventListener("click",()=>{const d=details[btn.dataset.open];document.getElementById("readerTitle").textContent=d[0];document.getElementById("readerText").textContent=d[1];document.getElementById("reader").classList.add("show");document.getElementById("reader").scrollIntoView({behavior:"smooth",block:"start"})}));
document.getElementById("closeReader").addEventListener("click",()=>document.getElementById("reader").classList.remove("show"));
document.getElementById("submitForm").addEventListener("submit",e=>{e.preventDefault();const f=new FormData(e.target);const summary=`MANGA HUB submission\nCreator: ${f.get("creator")}\nTitle: ${f.get("title")}\nGenre: ${f.get("genre")}\nLink: ${f.get("url")||"Not provided"}`;const blob=new Blob([summary],{type:"text/plain;charset=utf-8"});const url=URL.createObjectURL(blob);const a=document.createElement("a");a.href=url;a.download="manga-hub-submission.txt";a.click();URL.revokeObjectURL(url);const toast=document.getElementById("toast");toast.textContent=translations[lang].formToast;toast.classList.add("show");setTimeout(()=>toast.classList.remove("show"),3500)});
document.getElementById("year").textContent=new Date().getFullYear();
</script>
</body>
</html>